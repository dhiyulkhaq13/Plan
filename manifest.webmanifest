{
  "name": "HTML Viewer",
  "short_name": "HTML Viewer",
  "description": "Buka dan lihat file HTML di perangkatmu, bahkan saat offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "dir": "ltr",
  "lang": "id",
  "background_color": "#1d2433",
  "theme_color": "#1d2433",
  "categories": ["utilities", "productivity", "developer"],
  "prefer_related_applications": false,
  "launch_handler": {"client_mode": "navigate-existing"},
  "handle_links": "preferred",
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "screenshots": [
    {"src": "screenshots/wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Pratinjau halaman HTML di layar lebar"},
    {"src": "screenshots/narrow.png", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "Pratinjau halaman HTML di ponsel"}
  ],
  "shortcuts": [
    {"name": "Tempel kode", "short_name": "Kode", "description": "Buka tab Kode untuk menempel HTML", "url": "./?tab=code", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Riwayat", "short_name": "Riwayat", "description": "Lihat file yang terakhir dibuka", "url": "./?recent=1", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"text/html": [".html", ".htm"]}}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "file", "accept": ["text/html", ".html", ".htm"]}]}
  }
}
